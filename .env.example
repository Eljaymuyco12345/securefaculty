# SecureFaculty Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# Never commit your .env file to version control!

# Database Driver ('mysql' or 'sqlite')
DB_DRIVER=mysql

# MySQL / MariaDB Configuration (XAMPP / Docker / Production)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=securefaculty_db
DB_USER=root
DB_PASS=

# Python Executable Binary ('python' on Windows, 'python3' on Linux/Docker)
PYTHON_BIN=python

# Cryptographic Security (AES-256-CBC 64-character hex master key)
# Generate your own with: php -r "echo bin2hex(random_bytes(32));"
SECUREFACULTY_MASTER_KEY=CHANGE_ME_64_HEX_CHARACTERS

# OCR.space API Keys
OCR_PRIMARY_KEY=YOUR_OCR_SPACE_API_KEY
OCR_BACKUP_KEY=helloworld
OCR_MONTHLY_QUOTA=25000

# Gmail SMTP Configuration (For Forgot Password 6-Digit Email OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=YOUR_GMAIL_ADDRESS@gmail.com
SMTP_PASS=YOUR_16_CHAR_APP_PASSWORD
SMTP_FROM_NAME="SecureFaculty CICI Portal"
OTP_EXPIRY_MINUTES=15

# Session Inactivity Timeout (seconds; 600 = 10 minutes)
SESSION_TIMEOUT_SECONDS=600
